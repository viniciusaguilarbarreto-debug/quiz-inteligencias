<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <!-- Viewport configurado para evitar zoom e rolagem em celulares -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Aquário Virtual Mobile</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden; /* Impede rolagem */
            background-color: #001e2d;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            touch-action: none; /* Impede gestos nativos do navegador */
            user-select: none; /* Impede seleção de texto ao tocar */
            -webkit-user-select: none;
        }

        #aquarium {
            display: block;
            background: linear-gradient(to bottom, #006994 0%, #001e2d 100%);
            width: 100%;
            height: 100%;
        }

        /* Interface do Usuário */
        #ui-layer {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            background: rgba(255, 255, 255, 0.15);
            padding: 8px 15px;
            border-radius: 30px;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            z-index: 10;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .tool-btn {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid #00a8ff;
            color: white;
            padding: 10px 15px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.8rem;
            /* Melhoria para toque */
            min-width: 40px; 
            touch-action: manipulation;
        }

        .tool-btn:active, .tool-btn.active {
            background: #00a8ff;
            box-shadow: 0 0 15px #00a8ff;
            transform: scale(1.05);
        }

        #stats {
            position: absolute;
            bottom: 20px;
            left: 20px;
            color: white;
            font-size: 14px;
            pointer-events: none;
            text-shadow: 1px 1px 2px black;
            font-weight: bold;
            z-index: 9;
        }

        .overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            background: radial-gradient(circle at 50% -20%, rgba(255,255,255,0.15), transparent 60%);
            z-index: 5;
        }

        /* === RESPONSIVIDADE PARA CELULAR === */
        @media (max-width: 768px) {
            #ui-layer {
                top: auto;
                bottom: 20px; /* Move menu para baixo para fácil acesso com dedão */
                width: 90%;
                justify-content: space-between;
                padding: 10px;
                box-sizing: border-box;
            }

            .tool-btn {
                font-size: 0.7rem; /* Texto menor */
                padding: 12px 5px; /* Botão mais alto para facilitar toque */
                flex: 1; /* Distribui espaço igualmente */
                margin: 0 2px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                line-height: 1.2;
            }

            /* Ícones maiores no botão */
            .tool-btn span {
                font-size: 1.2rem;
                display: block;
                margin-bottom: 2px;
            }

            #stats {
                bottom: auto;
                top: 15px; /* Move stats para o topo */
                left: 15px;
                font-size: 12px;
                opacity: 0.8;
            }
        }
    </style>
</head>
<body>

    <div id="ui-layer">
        <!-- Adicionei spans para separar ícone do texto na responsividade -->
        <button class="tool-btn active" onclick="setTool('view')"><span>👀</span> Ver</button>
        <button class="tool-btn" onclick="setTool('feed')"><span>🦐</span> Ração</button>
        <button class="tool-btn" onclick="setTool('tap')"><span>👆</span> Tocar</button>
        <button class="tool-btn" onclick="setTool('net')"><span>🕸️</span> Rede</button>
    </div>

    <div id="stats">Peixes: <span id="fish-count">0</span> | Pegos: <span id="catch-count">0</span></div>
    
    <div class="overlay"></div>
    <canvas id="aquarium"></canvas>

<script>
    const canvas = document.getElementById('aquarium');
    const ctx = canvas.getContext('2d');
    
    let width, height;
    let particles = []; 
    let fishList = [];
    let caughtCount = 0;
    let currentTool = 'view';

    // === REDIMENSIONAMENTO INTELIGENTE (DPI) ===
    function resize() {
        // Pega a densidade de pixels do dispositivo (1 para PC, 2 ou 3 para celulares modernos)
        const dpr = window.devicePixelRatio || 1;
        
        // Define o tamanho visual do canvas CSS
        canvas.style.width = window.innerWidth + 'px';
        canvas.style.height = window.innerHeight + 'px';
        
        // Define o tamanho real do buffer de desenho (maior resolução)
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        
        width = window.innerWidth;
        height = window.innerHeight;

        // Normaliza o sistema de coordenadas para a lógica não quebrar com DPI alto
        ctx.scale(dpr, dpr);
    }
    
    // Resize ao carregar e ao girar a tela
    window.addEventListener('resize', resize);
    window.addEventListener('orientationchange', () => setTimeout(resize, 100));
    resize();

    // ================= CLASSES =================

    class Food {
        constructor(x, y) {
            this.x = x;
            this.y = y;
            this.vy = 0.5 + Math.random() * 1.5;
            this.size = 4 + Math.random() * 3; // Um pouco maior para ver no celular
            this.color = '#d4a373';
            this.active = true;
        }
        update() {
            this.y += this.vy;
            this.x += Math.sin(this.y * 0.1) * 0.5;
            if (this.y > height + 20) this.active = false;
        }
        draw() {
            ctx.fillStyle = this.color;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    class Bubble {
        constructor() {
            this.x = Math.random() * width;
            this.y = height + Math.random() * 100;
            this.vy = 1 + Math.random() * 3;
            this.size = 2 + Math.random() * 6;
            this.active = true;
        }
        update() {
            this.y -= this.vy;
            if (this.y < -20) {
                this.y = height + Math.random() * 100;
                this.x = Math.random() * width;
            }
        }
        draw() {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    class Creature {
        constructor(type) {
            this.type = type;
            this.x = Math.random() * width;
            this.y = Math.random() * height;
            this.angle = Math.random() * Math.PI * 2;
            this.speed = (type === 'shrimp') ? 0.5 : (1 + Math.random() * 2);
            this.baseSpeed = this.speed;
            this.size = (type === 'shrimp') ? 15 : (20 + Math.random() * 30);
            
            this.colorH = Math.random() * 360;
            this.color = `hsl(${this.colorH}, 75%, 50%)`;
            
            this.state = 'idle'; 
            this.target = null;
            this.panicTimer = 0;
            
            this.vx = Math.cos(this.angle) * this.speed;
            this.vy = Math.sin(this.angle) * this.speed;
        }

        update() {
            if (this.panicTimer > 0) {
                this.panicTimer--;
                this.speed = this.baseSpeed * 3.5; 
            } else if (this.state === 'chasing_food' && this.target && this.target.active) {
                this.speed = this.baseSpeed * 2.2;
                let dx = this.target.x - this.x;
                let dy = this.target.y - this.y;
                let dist = Math.sqrt(dx*dx + dy*dy);
                
                if (dist < this.size) {
                    this.target.active = false;
                    this.state = 'idle';
                    this.size = Math.min(this.size + 2, 70); 
                } else {
                    this.angle = Math.atan2(dy, dx);
                }
            } else {
                this.speed = this.baseSpeed;
                this.state = 'idle';
                
                let food = particles.find(p => p instanceof Food && p.active && Math.abs(p.x - this.x) < 250 && Math.abs(p.y - this.y) < 250);
                if (food) {
                    this.state = 'chasing_food';
                    this.target = food;
                }

                if (Math.random() < 0.02) {
                    this.angle += (Math.random() - 0.5) * 1.5;
                }
            }

            if (this.type === 'shrimp') {
                if (this.y < height - 100) this.angle = Math.PI / 2;
            }

            this.vx = this.vx * 0.95 + (Math.cos(this.angle) * this.speed) * 0.05;
            this.vy = this.vy * 0.95 + (Math.sin(this.angle) * this.speed) * 0.05;

            this.x += this.vx;
            this.y += this.vy;

            const margin = 50;
            if (this.x < margin) this.vx += 0.5;
            if (this.x > width - margin) this.vx -= 0.5;
            if (this.y < margin) this.vy += 0.5;
            if (this.y > height - margin) this.vy -= 0.5;
            
            this.angle = Math.atan2(this.vy, this.vx);
        }

        draw() {
            ctx.save();
            ctx.translate(this.x, this.y);
            
            if (Math.abs(this.angle) > Math.PI / 2) {
                ctx.scale(1, -1);
                ctx.rotate(this.angle);
            } else {
                ctx.rotate(this.angle);
            }
            
            if (this.type === 'fish') {
                // Corpo
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.ellipse(0, 0, this.size, this.size/2, 0, 0, Math.PI*2);
                ctx.fill();
                // Sombra/Brilho
                ctx.fillStyle = 'rgba(255,255,255,0.2)';
                ctx.beginPath();
                ctx.ellipse(0, -this.size/4, this.size*0.8, this.size/4, 0, 0, Math.PI*2);
                ctx.fill();

                // Cauda
                let tailWag = Math.sin(Date.now() * 0.01 * this.speed) * (this.size/4);
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.moveTo(-this.size + 5, 0);
                ctx.lineTo(-this.size * 1.5, -this.size/2 + tailWag);
                ctx.lineTo(-this.size * 1.5, this.size/2 + tailWag);
                ctx.fill();
                
                // Olho
                ctx.fillStyle = 'white';
                ctx.beginPath();
                ctx.arc(this.size/2, -this.size/6, this.size/6, 0, Math.PI*2);
                ctx.fill();
                ctx.fillStyle = 'black';
                ctx.beginPath();
                ctx.arc(this.size/2 + 2, -this.size/6, this.size/12, 0, Math.PI*2);
                ctx.fill();
            } else if (this.type === 'shrimp') {
                ctx.fillStyle = '#ff6b6b';
                ctx.beginPath();
                ctx.arc(0, 0, this.size/2, 0, Math.PI*2);
                ctx.fill();
                ctx.strokeStyle = '#ff6b6b';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(0,0);
                ctx.lineTo(25, -15);
                ctx.moveTo(0,0);
                ctx.lineTo(25, 15);
                ctx.stroke();
            }

            ctx.restore();
        }

        flee(fromX, fromY) {
            this.panicTimer = 60;
            this.angle = Math.atan2(this.y - fromY, this.x - fromX);
        }
    }

    // ================= SISTEMA =================

    // População inicial baseada no tamanho da tela
    let initialFish = window.innerWidth < 600 ? 10 : 18;
    for(let i=0; i<initialFish; i++) {
        fishList.push(new Creature('fish'));
    }
    for(let i=0; i<4; i++) {
        fishList.push(new Creature('shrimp'));
    }
    for(let i=0; i<25; i++) {
        particles.push(new Bubble());
    }

    function animate() {
        ctx.clearRect(0, 0, width, height);

        particles.forEach((p, index) => {
            if (!p.active) {
                particles.splice(index, 1);
                return;
            }
            p.update();
            p.draw();
        });

        fishList.forEach((fish, index) => {
            fish.update();
            fish.draw();
        });

        document.getElementById('fish-count').innerText = fishList.length;
        document.getElementById('catch-count').innerText = caughtCount;

        requestAnimationFrame(animate);
    }
    animate();

    // ================= INTERAÇÃO (TOUCH & MOUSE) =================

    function setTool(tool) {
        currentTool = tool;
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        
        const buttons = document.querySelectorAll('.tool-btn');
        if(tool === 'view') buttons[0].classList.add('active');
        if(tool === 'feed') buttons[1].classList.add('active');
        if(tool === 'tap') buttons[2].classList.add('active');
        if(tool === 'net') buttons[3].classList.add('active');
        
        // Cursor muda apenas em desktop
        if (window.matchMedia("(hover: hover)").matches) {
            canvas.style.cursor = tool === 'net' ? 'crosshair' : (tool === 'feed' ? 'copy' : 'default');
        }
    }

    // Função unificada para processar entrada (Toque ou Mouse)
    function handleInput(inputX, inputY) {
        // Obter coordenadas relativas ao canvas
        // Como o canvas ocupa a tela toda com position fixed/block, clientX/Y geralmente funcionam direto
        // mas é bom garantir.
        const x = inputX;
        const y = inputY;

        if (currentTool === 'feed') {
            particles.push(new Food(x, y));
        }
        else if (currentTool === 'tap') {
            // Efeito visual do toque
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.arc(x, y, 40, 0, Math.PI*2);
            ctx.stroke();
            
            // Espantar peixes
            fishList.forEach(fish => {
                let d = Math.sqrt((fish.x - x)**2 + (fish.y - y)**2);
                if (d < 250) fish.flee(x, y);
            });
        }
        else if (currentTool === 'net') {
            let caught = false;
            // Iterar ao contrário para remover sem erro de índice
            for (let i = fishList.length - 1; i >= 0; i--) {
                let fish = fishList[i];
                let d = Math.sqrt((fish.x - x)**2 + (fish.y - y)**2);
                
                // Área de captura aumentada para facilitar no celular
                if (d < fish.size + 40) {
                    if (Math.random() > 0.2) { 
                        fishList.splice(i, 1);
                        caughtCount++;
                        caught = true;
                        
                        // Efeito visual de captura
                        ctx.fillStyle = 'rgba(255, 255, 0, 0.5)';
                        ctx.beginPath();
                        ctx.arc(x, y, 30, 0, Math.PI*2);
                        ctx.fill();
                        
                        break; // Captura um por toque
                    } else {
                        fish.flee(x, y);
                    }
                }
            }
            if(!caught) {
                // Desenha rede falhando
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
                ctx.beginPath();
                ctx.arc(x, y, 30, 0, Math.PI*2);
                ctx.stroke();
            }
        }
    }

    // Evento de Mouse
    canvas.addEventListener('mousedown', (e) => {
        handleInput(e.clientX, e.clientY);
    });

    // Evento de Toque (Celular)
    canvas.addEventListener('touchstart', (e) => {
        // Previne comportamentos padrão como scroll ou zoom duplo
        if(e.target === canvas) {
            e.preventDefault();
        }
        
        // Processa o primeiro dedo que tocou
        const touch = e.touches[0];
        handleInput(touch.clientX, touch.clientY);
    }, { passive: false });

</script>
</body>
</html>
