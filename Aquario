<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aquário Virtual Realista</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #001e2d;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        #aquarium {
            display: block;
            background: linear-gradient(to bottom, #006994 0%, #001e2d 100%);
            cursor: crosshair;
        }

        /* Interface do Usuário */
        #ui-layer {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            background: rgba(255, 255, 255, 0.1);
            padding: 10px 20px;
            border-radius: 30px;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            z-index: 10;
        }

        .tool-btn {
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid #00a8ff;
            color: white;
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.8rem;
        }

        .tool-btn:hover {
            background: #00a8ff;
            box-shadow: 0 0 15px #00a8ff;
        }

        .tool-btn.active {
            background: #00a8ff;
            box-shadow: 0 0 20px #00a8ff;
            transform: scale(1.1);
        }

        #stats {
            position: absolute;
            bottom: 20px;
            left: 20px;
            color: white;
            font-size: 14px;
            pointer-events: none;
            text-shadow: 1px 1px 2px black;
        }

        /* Efeitos de bolhas e luz */
        .overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            background: radial-gradient(circle at 50% -20%, rgba(255,255,255,0.2), transparent 60%);
            z-index: 5;
        }
    </style>
</head>
<body>

    <div id="ui-layer">
        <button class="tool-btn active" onclick="setTool('view')">👀 Observar</button>
        <button class="tool-btn" onclick="setTool('feed')">🦐 Dar Ração</button>
        <button class="tool-btn" onclick="setTool('tap')">👆 Tocar Vidro</button>
        <button class="tool-btn" onclick="setTool('net')">🕸️ Capturar</button>
    </div>

    <div id="stats">Peixes no tanque: <span id="fish-count">0</span> | Capturados: <span id="catch-count">0</span></div>
    
    <div class="overlay"></div>
    <canvas id="aquarium"></canvas>

<script>
    const canvas = document.getElementById('aquarium');
    const ctx = canvas.getContext('2d');
    
    let width, height;
    let particles = []; // Comida e Bolhas
    let fishList = [];
    let caughtCount = 0;
    
    // Ferramenta atual
    let currentTool = 'view'; // view, feed, tap, net

    // Imagens (Placeholders - O usuário deve substituir pelas URLs reais)
    // Se não houver imagem, o código desenha formas coloridas
    const assets = {
        fish1: new Image(), // Peixe Dourado
        fish2: new Image(), // Neon
        shrimp: new Image(), // Camarão
        bg: new Image()
    };
    // Descomente e coloque URLs reais para usar imagens
    // assets.fish1.src = 'caminho_para_peixe.png';

    // Configuração do redimensionamento
    function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    // ================= CLASSES =================

    class Food {
        constructor(x, y) {
            this.x = x;
            this.y = y;
            this.vy = 0.5 + Math.random() * 1.5; // Velocidade de queda
            this.size = 3 + Math.random() * 3;
            this.color = '#d4a373';
            this.active = true;
        }
        update() {
            this.y += this.vy;
            // Balancear levemente
            this.x += Math.sin(this.y * 0.1) * 0.5;
            
            if (this.y > height) this.active = false;
        }
        draw() {
            ctx.fillStyle = this.color;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    class Bubble {
        constructor() {
            this.x = Math.random() * width;
            this.y = height + Math.random() * 100;
            this.vy = 1 + Math.random() * 3;
            this.size = 1 + Math.random() * 5;
            this.active = true;
        }
        update() {
            this.y -= this.vy;
            if (this.y < -10) {
                this.y = height + Math.random() * 100;
                this.x = Math.random() * width;
            }
        }
        draw() {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    class Creature {
        constructor(type) {
            this.type = type; // fish, shrimp, bottom_feeder
            this.x = Math.random() * width;
            this.y = Math.random() * height;
            this.angle = Math.random() * Math.PI * 2;
            this.speed = (type === 'shrimp') ? 0.5 : (1 + Math.random() * 2);
            this.baseSpeed = this.speed;
            this.size = (type === 'shrimp') ? 15 : (20 + Math.random() * 30);
            
            // Cores processuais se não houver imagem
            this.colorH = Math.random() * 360;
            this.color = `hsl(${this.colorH}, 70%, 50%)`;
            
            this.state = 'idle'; // idle, fleeing, chasing_food
            this.target = null;
            this.panicTimer = 0;
            
            // Movimento suave
            this.vx = Math.cos(this.angle) * this.speed;
            this.vy = Math.sin(this.angle) * this.speed;
        }

        update() {
            // IA de Estado
            if (this.panicTimer > 0) {
                this.panicTimer--;
                this.speed = this.baseSpeed * 3; // Nadar rápido
            } else if (this.state === 'chasing_food' && this.target && this.target.active) {
                this.speed = this.baseSpeed * 2;
                let dx = this.target.x - this.x;
                let dy = this.target.y - this.y;
                let dist = Math.sqrt(dx*dx + dy*dy);
                
                // Comer
                if (dist < this.size) {
                    this.target.active = false; // Comida sumiu
                    this.state = 'idle';
                    this.size = Math.min(this.size + 1, 60); // Crescer
                } else {
                    // Mirar na comida
                    this.angle = Math.atan2(dy, dx);
                }
            } else {
                // Modo ocioso
                this.speed = this.baseSpeed;
                this.state = 'idle';
                
                // Procurar comida próxima
                let food = particles.find(p => p instanceof Food && p.active && Math.abs(p.x - this.x) < 200 && Math.abs(p.y - this.y) < 200);
                if (food) {
                    this.state = 'chasing_food';
                    this.target = food;
                }

                // Mudança de direção aleatória suave
                if (Math.random() < 0.02) {
                    this.angle += (Math.random() - 0.5) * 1;
                }
            }

            // Invertebrados ficam no fundo
            if (this.type === 'shrimp') {
                if (this.y < height - 100) this.angle = Math.PI / 2; // Forçar descer
            }

            // Calcular velocidade baseada no angulo
            this.vx = this.vx * 0.95 + (Math.cos(this.angle) * this.speed) * 0.05;
            this.vy = this.vy * 0.95 + (Math.sin(this.angle) * this.speed) * 0.05;

            this.x += this.vx;
            this.y += this.vy;

            // Colisão com bordas (rebatimento suave)
            const margin = 50;
            if (this.x < margin) this.vx += 0.5;
            if (this.x > width - margin) this.vx -= 0.5;
            if (this.y < margin) this.vy += 0.5;
            if (this.y > height - margin) this.vy -= 0.5;
            
            // Atualizar ângulo real baseado no vetor velocidade
            this.angle = Math.atan2(this.vy, this.vx);
        }

        draw() {
            ctx.save();
            ctx.translate(this.x, this.y);
            
            // Virar peixe se estiver indo para a esquerda
            if (Math.abs(this.angle) > Math.PI / 2) {
                ctx.scale(1, -1);
                ctx.rotate(this.angle);
            } else {
                ctx.rotate(this.angle);
            }

            // AQUI É ONDE ENTRA O DESENHO (OU IMAGEM)
            // Se eu fosse usar imagem: ctx.drawImage(assets.fish1, -size, -size/2, size*2, size);
            
            // Desenho Processual (Fallback)
            if (this.type === 'fish') {
                // Corpo
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.ellipse(0, 0, this.size, this.size/2, 0, 0, Math.PI*2);
                ctx.fill();
                // Cauda (animação simples)
                let tailWag = Math.sin(Date.now() * 0.01 * this.speed) * 5;
                ctx.beginPath();
                ctx.moveTo(-this.size + 5, 0);
                ctx.lineTo(-this.size - 15, -10 + tailWag);
                ctx.lineTo(-this.size - 15, 10 + tailWag);
                ctx.fill();
                // Olho
                ctx.fillStyle = 'white';
                ctx.beginPath();
                ctx.arc(this.size/2, -this.size/6, 3, 0, Math.PI*2);
                ctx.fill();
                ctx.fillStyle = 'black';
                ctx.beginPath();
                ctx.arc(this.size/2 + 1, -this.size/6, 1, 0, Math.PI*2);
                ctx.fill();
            } else if (this.type === 'shrimp') {
                ctx.fillStyle = '#ff6b6b';
                ctx.beginPath();
                ctx.arc(0, 0, this.size/2, 0, Math.PI*2);
                ctx.fill();
                // Antenas
                ctx.strokeStyle = '#ff6b6b';
                ctx.beginPath();
                ctx.moveTo(0,0);
                ctx.lineTo(20, -10);
                ctx.moveTo(0,0);
                ctx.lineTo(20, 10);
                ctx.stroke();
            }

            ctx.restore();
        }

        flee(fromX, fromY) {
            this.panicTimer = 60; // 1 segundo de pânico
            this.angle = Math.atan2(this.y - fromY, this.x - fromX);
        }
    }

    // ================= SISTEMA =================

    // Inicializar Peixes
    for(let i=0; i<15; i++) {
        fishList.push(new Creature('fish'));
    }
    for(let i=0; i<5; i++) {
        fishList.push(new Creature('shrimp'));
    }

    // Inicializar Bolhas
    for(let i=0; i<20; i++) {
        particles.push(new Bubble());
    }

    // Loop Principal
    function animate() {
        ctx.clearRect(0, 0, width, height);

        // Atualizar e desenhar bolhas e comida
        particles.forEach((p, index) => {
            if (!p.active) {
                particles.splice(index, 1);
                return;
            }
            p.update();
            p.draw();
        });

        // Atualizar e desenhar criaturas
        fishList.forEach((fish, index) => {
            fish.update();
            fish.draw();
        });

        // Efeito da Rede (Visual)
        if (currentTool === 'net') {
            // Desenhar círculo do mouse
            // Isso seria feito no evento mousemove, mas simples aqui
        }

        document.getElementById('fish-count').innerText = fishList.length;
        document.getElementById('catch-count').innerText = caughtCount;

        requestAnimationFrame(animate);
    }
    animate();

    // ================= INTERAÇÃO =================

    function setTool(tool) {
        currentTool = tool;
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        // Encontrar botão correto para adicionar active (simplificado)
        const buttons = document.querySelectorAll('.tool-btn');
        if(tool === 'view') buttons[0].classList.add('active');
        if(tool === 'feed') buttons[1].classList.add('active');
        if(tool === 'tap') buttons[2].classList.add('active');
        if(tool === 'net') buttons[3].classList.add('active');
        
        canvas.style.cursor = tool === 'net' ? 'crosshair' : (tool === 'feed' ? 'copy' : 'default');
    }

    canvas.addEventListener('mousedown', (e) => {
        const rect = canvas.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;

        if (currentTool === 'feed') {
            particles.push(new Food(mouseX, mouseY));
        }
        else if (currentTool === 'tap') {
            // Criar onda de choque
            ctx.strokeStyle = 'white';
            ctx.lineWidth = 5;
            ctx.beginPath();
            ctx.arc(mouseX, mouseY, 50, 0, Math.PI*2);
            ctx.stroke();
            
            fishList.forEach(fish => {
                let d = Math.sqrt((fish.x - mouseX)**2 + (fish.y - mouseY)**2);
                if (d < 200) fish.flee(mouseX, mouseY);
            });
        }
        else if (currentTool === 'net') {
            // Tentar capturar
            for (let i = fishList.length - 1; i >= 0; i--) {
                let fish = fishList[i];
                let d = Math.sqrt((fish.x - mouseX)**2 + (fish.y - mouseY)**2);
                
                // Se o clique for próximo o suficiente e o peixe não estiver muito rápido
                if (d < fish.size + 20) {
                    if (Math.random() > 0.3) { // 70% de chance de pegar
                        fishList.splice(i, 1);
                        caughtCount++;
                        // Efeito visual de captura
                        break; // Pega um por vez
                    } else {
                        fish.flee(mouseX, mouseY); // Peixe escapou!
                    }
                }
            }
        }
    });

</script>
</body>
</html>
